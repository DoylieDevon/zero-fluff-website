{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/get-in-touch",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.zerofluff.co.uk"
        }
      ],
      "destination": "https://zerofluff.co.uk/:path",
      "permanent": true
    }
  ]
}
