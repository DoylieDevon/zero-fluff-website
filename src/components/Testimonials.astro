---
// Real client testimonials from src/config/site-inputs.ts. Renders nothing when
// there are none, so there are never placeholder quotes on the live site.
// Review JSON-LD is emitted only for real entries (and carries no star rating —
// we don't invent one).
import Testimonial from './Testimonial.astro';
import { siteInputs } from '../config/site-inputs';

interface Props {
  /** Show only testimonials for these case studies (plus general ones with no case study). Leave out to show all. */
  caseStudyIds?: string[];
  heading?: string;
  limit?: number;
}

const { caseStudyIds, heading = 'What clients say', limit = 3 } = Astro.props;

const items = siteInputs.testimonials
  .filter((t) => !caseStudyIds || t.caseStudyId === null || caseStudyIds.includes(t.caseStudyId))
  .slice(0, limit);

const reviewSchema = items.map((t) => ({
  '@context': 'https://schema.org',
  '@type': 'Review',
  itemReviewed: { '@id': 'https://zerofluff.co.uk/#business' },
  author: { '@type': 'Person', name: t.name },
  reviewBody: t.quote,
}));
---

{items.length > 0 && (
  <section class="testimonials-section">
    <div class="testimonials-inner">
      <h2>{heading}</h2>
      <div class="testimonials-list">
        {items.map((t) => (
          <Testimonial quote={t.quote} name={t.name} role={t.role} company={t.company} />
        ))}
      </div>
    </div>
    {reviewSchema.map((r) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(r)} />
    ))}
  </section>
)}

<style>
  .testimonials-section {
    background: var(--color-bg);
    padding: 80px;
  }
  .testimonials-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .testimonials-inner h2 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--color-text);
  }
  .testimonials-list {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  @media (max-width: 768px) {
    .testimonials-section {
      padding: 60px 24px;
    }
  }
</style>
