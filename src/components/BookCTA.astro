---
// The one call-to-action button. Goes to the booking page when
// siteInputs.bookingUrl is set (new tab), otherwise to /contact, and carries the
// "what happens next" reassurance line.
import { booking, REASSURANCE } from '../lib/booking';

interface Props {
  label?: string;
  /** Override the destination (e.g. a secondary link). Leave out for the booking CTA. */
  href?: string;
  /** Show the reassurance line under the button. Default true. */
  note?: boolean;
  align?: 'start' | 'center';
  large?: boolean;
  magnetic?: boolean;
  class?: string;
}

const {
  label = 'Book a free AI chat →',
  href,
  note = true,
  align = 'start',
  large = false,
  magnetic = false,
  class: className,
} = Astro.props;

const b = booking();
const target = href ?? b.href;
const external = href ? /^https?:\/\//.test(href) : b.external;
---

<div class:list={['book-cta', align, className]}>
  <a
    href={target}
    class:list={['book-btn', { large }]}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
    data-magnetic={magnetic ? '' : undefined}
  >{label}{external && <span class="book-sr"> (opens in a new tab)</span>}</a>
  {note && <p class="book-note">{REASSURANCE}</p>}
</div>

<style>
  .book-cta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
    align-self: flex-start;
  }
  .book-cta.center {
    align-items: center;
    align-self: center;
    text-align: center;
  }
  .book-btn {
    display: inline-flex;
    align-items: center;
    background: var(--color-accent, #FF3B30);
    color: #fff;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 600;
    padding: 16px 32px;
    text-decoration: none;
    transition: background 0.2s, transform 0.2s;
  }
  .book-btn.large {
    font-size: 18px;
    padding: 20px 48px;
  }
  .book-btn:hover {
    background: var(--color-accent-hover, #e0352b);
    color: #fff;
  }
  .book-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .book-note {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted, #A1A1AA);
    margin: 0;
  }
  .book-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
