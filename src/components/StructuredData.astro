---
// Site-wide structured data (JSON-LD).
// Rendered inside <head> on every page via BaseLayout.
// LocalBusiness (ProfessionalService) + Organization graph for Zero Fluff,
// a Totnes-based AI & automation consultancy serving the South West UK.

import { SERVICES, servicePath } from '../lib/services';

const site = 'https://zerofluff.co.uk';

const directors = [
  {
    '@type': 'Person',
    name: 'Andy Doyle',
    jobTitle: 'Director',
    url: 'https://andy.zerofluff.co.uk',
    sameAs: ['https://www.linkedin.com/in/doylie'],
  },
  {
    '@type': 'Person',
    name: 'Philippa Doyle',
    jobTitle: 'Director',
    sameAs: ['https://www.linkedin.com/in/philippadoyle'],
  },
];

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site}/#business`,
  name: 'Zero Fluff',
  description:
    'Hands-on AI and automation consultancy in Totnes, Devon, helping small businesses across the South West UK save time and money with practical AI — no jargon, no fluff.',
  url: site,
  email: 'andy@zerofluff.co.uk',
  telephone: '+44 7900 241369',
  image: `${site}/og-image.jpg`,
  logo: `${site}/images/logo-horizontal-white.png`,
  priceRange: '££',
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '17:00',
    },
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Totnes',
    addressRegion: 'Devon',
    postalCode: 'TQ9',
    addressCountry: 'GB',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 50.4319,
    longitude: -3.6863,
  },
  areaServed: [
    { '@type': 'AdministrativeArea', name: 'Devon' },
    { '@type': 'AdministrativeArea', name: 'Cornwall' },
    { '@type': 'AdministrativeArea', name: 'Somerset' },
    { '@type': 'AdministrativeArea', name: 'Dorset' },
    { '@type': 'City', name: 'Bristol' },
    { '@type': 'Place', name: 'South West England' },
  ],
  knowsAbout: [
    'Artificial Intelligence',
    'Business Automation',
    'Custom AI Software Development',
    'AI Implementation',
    'Workflow Automation',
    'n8n',
    'AI Agents',
    'Fractional CTO',
    'AI Consultancy',
  ],
  founder: {
    '@type': 'Person',
    name: 'Andy Doyle',
    email: 'andy@zerofluff.co.uk',
    url: 'https://andy.zerofluff.co.uk',
  },
  employee: directors,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'AI & Automation Services',
    itemListElement: [
      ...SERVICES.map((svc) => ({
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: svc.name,
          description: svc.summary,
          url: `${site}${servicePath(svc.slug)}`,
        },
      })),
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Ongoing AI Support',
          description:
            'A monthly retainer that keeps your automations running and adds new ones as opportunities arise.',
          url: `${site}/services/#support`,
        },
      },
    ],
  },
};

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}/#organization`,
  name: 'Zero Fluff',
  legalName: 'The Digital Partnership Ltd',
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Companies House company number',
    value: '09850681',
  },
  url: site,
  logo: `${site}/images/logo-horizontal-white.png`,
  image: `${site}/og-image.jpg`,
  email: 'andy@zerofluff.co.uk',
  telephone: '+44 7900 241369',
  description:
    'Straight-talking AI and automation consultancy for small businesses in Devon and the South West UK.',
  founder: {
    '@type': 'Person',
    name: 'Andy Doyle',
  },
  employee: directors,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Totnes',
    addressRegion: 'Devon',
    postalCode: 'TQ9',
    addressCountry: 'GB',
  },
  sameAs: [
    'https://www.linkedin.com/company/zerofluff',
    'https://zerofluff.substack.com',
    'https://andy.zerofluff.co.uk',
  ],
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(localBusiness)}
/>
<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(organization)}
/>
