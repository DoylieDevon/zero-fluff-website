---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCTA from '../components/BookCTA.astro';
import PriceTag from '../components/PriceTag.astro';
import Testimonials from '../components/Testimonials.astro';
import { SERVICES, servicePath } from '../lib/services';
export const prerender = true;

const site = 'https://zerofluff.co.uk';
const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Zero Fluff services',
  itemListElement: SERVICES.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: `${site}${servicePath(s.slug)}`,
  })),
};
---

<BaseLayout
  title="AI, Automation & Software Services — Zero Fluff"
  description="Custom AI software, automation, n8n builds, AI agents, fractional CTO and a 2-hour AI Quick Start. Practical services for UK small businesses, built and supported."
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(listSchema)} />

  <section class="hub-hero">
    <div class="hub-hero-content">
      <h1>Software and automation,<br>built and supported</h1>
      <p>Real implementations that save you time and money, not slide decks about the future of AI. We build custom AI software and automation for small businesses across the UK, from our base in Totnes, Devon.</p>
      <BookCTA />
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-inner">
      <span class="hub-label">WHAT WE DO</span>
      <h2>Pick the one that sounds like your problem</h2>
      <div class="hub-grid">
        {SERVICES.map((s) => (
          <a href={servicePath(s.slug)} class="hub-card">
            <h3>{s.name}</h3>
            <p>{s.summary}</p>
            {s.priceKey && <PriceTag of={s.priceKey} />}
            <span class="hub-more">Learn more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="hub-section hub-alt" id="support">
    <div class="hub-inner hub-narrow">
      <span class="hub-label">MONTHLY</span>
      <h2>Ongoing AI support &amp; consultancy</h2>
      <p class="hub-lede">AI moves fast and businesses change. This monthly retainer keeps what we build running, fixes what breaks, adds new automations as opportunities arise and advises on what is worth trying.</p>
      <ul class="hub-list">
        <li>Monthly strategy call</li>
        <li>Unlimited small automation fixes</li>
        <li>New tool evaluations and recommendations</li>
        <li>Priority response to issues</li>
      </ul>
      <PriceTag of="retainer" />
      <BookCTA label="Ask about support →" />
    </div>
  </section>

  <section class="hub-section">
    <div class="hub-inner hub-narrow">
      <span class="hub-label">HOW WE BUILD</span>
      <h2>Reliable, not just quick</h2>
      <p class="hub-lede">Every build is tested, documented and handed over properly, with 30 days of support included. <a href="/#how-we-build" class="hub-link">See how we build →</a></p>
    </div>
  </section>

  <Testimonials />

  <section class="hub-section hub-alt">
    <div class="hub-inner">
      <span class="hub-label">EXPLORE MORE</span>
      <h2>See it in practice</h2>
      <div class="hub-grid hub-grid-3">
        <a href="/case-studies" class="hub-card"><h3>Case studies →</h3><p>Real results for real businesses.</p></a>
        <a href="/ai-automation-devon" class="hub-card"><h3>AI for Devon businesses →</h3><p>How we help businesses across Devon.</p></a>
        <a href="/ai-consultancy-south-west" class="hub-card"><h3>AI consultancy in the South West →</h3><p>Practical AI consultancy across the region.</p></a>
      </div>
    </div>
  </section>

  <section class="hub-cta">
    <h2>Ready to get started?</h2>
    <p>Tell us what you are stuck with. We will tell you straight whether we can help.</p>
    <BookCTA large align="center" />
  </section>
</BaseLayout>

<style>
  .hub-hero {
    min-height: 500px;
    background: var(--color-surface);
    display: flex;
    align-items: flex-end;
    padding: 140px 0 80px;
  }
  .hub-hero-content {
    padding: 0 80px;
    max-width: 880px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .hub-hero h1 {
    font-size: clamp(36px, 5vw, 56px);
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -1.5px;
    line-height: 1.05;
  }
  .hub-hero p {
    font-size: 20px;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .hub-section {
    background: var(--color-bg);
    padding: 80px;
  }
  .hub-alt { background: var(--color-surface); }
  .hub-inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hub-narrow { max-width: 820px; }
  .hub-label {
    font-size: 12px;
    font-weight: 700;
    color: #FF3B30;
    letter-spacing: 3px;
    text-transform: uppercase;
  }
  .hub-inner > h2 {
    font-size: 36px;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -0.5px;
    margin-bottom: 16px;
  }
  .hub-lede {
    font-size: 18px;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }
  .hub-link {
    color: #FF3B30;
    text-decoration: none;
    font-weight: 600;
  }
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .hub-grid-3 { grid-template-columns: repeat(3, 1fr); }
  .hub-card {
    border: 1px solid var(--color-border);
    padding: 28px;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .hub-card:hover { border-color: #FF3B30; transform: translateY(-2px); }
  .hub-card h3 {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.2;
  }
  .hub-card p {
    font-size: 16px;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }
  .hub-more {
    margin-top: auto;
    font-size: 15px;
    font-weight: 600;
    color: #FF3B30;
  }
  .hub-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .hub-list li {
    font-size: 17px;
    color: var(--color-text-secondary);
    padding-left: 22px;
    position: relative;
  }
  .hub-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: #FF3B30;
    font-weight: 600;
  }
  .hub-cta {
    background: var(--color-bg);
    padding: 100px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .hub-cta h2 {
    font-size: 40px;
    font-weight: 800;
    color: var(--color-text);
    letter-spacing: -1px;
  }
  .hub-cta p {
    font-size: 18px;
    color: var(--color-text-secondary);
    max-width: 520px;
  }
  @media (max-width: 1000px) {
    .hub-grid, .hub-grid-3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .hub-hero-content { padding: 0 24px; }
    .hub-section { padding: 60px 24px; }
    .hub-grid, .hub-grid-3 { grid-template-columns: 1fr; }
  }
</style>
